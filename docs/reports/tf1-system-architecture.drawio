        </mxCell>
        <mxCell id="s1_text" parent="s1" value="Send incident_seed.v1 (lightweight) &amp;lt;b&amp;gt;NOT&amp;lt;/b&amp;gt; full metrics/logs&amp;lt;br/&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;Fields:&amp;lt;/b&amp;gt; tenant_id, incident_id, service, severity, time" style="text;html=1;align=center;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=9;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="10" y="80" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="github" parent="1" value="&amp;lt;b&amp;gt;GitHub Actions CI&amp;lt;/b&amp;gt;" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=30;collapsible=0;fillColor=none;strokeColor=#546E7A;swimlaneFillColor=#FFFFFF;fontColor=#546E7A;rounded=1;arcSize=8;fontSize=10;" vertex="1">

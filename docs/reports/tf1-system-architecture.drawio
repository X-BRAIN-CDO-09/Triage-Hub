        <mxCell id="s1_icon" parent="s1" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#546E7A;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;" vertex="1">

        <mxCell id="github_text" parent="github" value="Docker build → Trivy scan (fail HIGH/CRITICAL) → Cosign sign → Push image" style="text;html=1;align=center;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=9;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="10" y="80" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="seed_tag" parent="1" value="&amp;lt;b&amp;gt;incident_seed.v1&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;{ tenant_id, incident_id,&amp;lt;br/&amp;gt;service, severity, time }" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=8;dashed=1;fillColor=#FFFFFF;strokeColor=#0B7B70;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="80" y="690" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vpc" parent="1" value="VPC – Private Subnet (No Internet Route)" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=26;collapsible=0;fillColor=none;strokeColor=#0B7B70;swimlaneFillColor=#FFFFFF;fontColor=#0B7B70;rounded=1;arcSize=4;fontSize=12;dashed=1;strokeWidth=2;" vertex="1">
          <mxGeometry x="340" y="100" width="840" height="1220" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="vpc" value="3. Amazon API Gateway" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=26;collapsible=0;fillColor=none;strokeColor=#5E35B1;swimlaneFillColor=#FFFFFF;fontColor=#5E35B1;rounded=1;arcSize=8;fontSize=9;" vertex="1">
          <mxGeometry x="20" y="45" width="230" height="180" as="geometry" />
        </mxCell>
        <mxCell id="s2_icon" parent="s2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1">
          <mxGeometry x="95" y="30" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2_text" parent="s2" value="&amp;lt;b&amp;gt;Private REST API&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;POST /v1/triage&amp;lt;br/&amp;gt;GET /v1/reports&amp;lt;br/&amp;gt;GET /v1/reports/{id}" style="text;html=1;align=center;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=8;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="10" y="75" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2_auth" parent="s2" value="Auth: IAM SigV4 (preferred) / SERVICE_AUTH_TOKEN bearer" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=7;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#F57F17;" vertex="1">
          <mxGeometry x="10" y="130" width="210" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="vpc" value="4. Ingestor (AWS Lambda)" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=26;collapsible=0;fillColor=none;strokeColor=#546E7A;swimlaneFillColor=#FFFFFF;fontColor=#546E7A;rounded=1;arcSize=8;fontSize=9;" vertex="1">
          <mxGeometry x="270" y="45" width="230" height="180" as="geometry" />
        </mxCell>
        <mxCell id="s3_icon" parent="s3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#FF9900;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1">
          <mxGeometry x="95" y="30" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s3_text" parent="s3" value="&amp;lt;b&amp;gt;validate + forward seed&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;br/&amp;gt;• Validate schema&amp;lt;br/&amp;gt;• Multi-tenant tag (tenant_id)&amp;lt;br/&amp;gt;• Forward seed (no aggregation)" style="text;html=1;align=left;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=8;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="10" y="75" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s4a" parent="vpc" value="5. Buffer Queue (Amazon SQS)" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=26;collapsible=0;fillColor=none;strokeColor=#0B7B70;swimlaneFillColor=#FFFFFF;fontColor=#0B7B70;rounded=1;arcSize=8;fontSize=9;" vertex="1">
          <mxGeometry x="20" y="240" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s4a_icon" parent="s4a" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#FF4F8B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1">
          <mxGeometry x="10" y="40" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s4a_text" parent="s4a" value="• Buffer incident seeds&amp;lt;br/&amp;gt;• Decouple spikes&amp;lt;br/&amp;gt;• Long polling" style="text;html=1;align=left;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=8;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="50" y="40" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4b" parent="vpc" value="6. DLQ (Dead-Letter Queue)" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=26;collapsible=0;fillColor=none;strokeColor=#0B7B70;swimlaneFillColor=#FFFFFF;fontColor=#0B7B70;rounded=1;arcSize=8;fontSize=9;" vertex="1">
          <mxGeometry x="20" y="380" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s4b_icon" parent="s4b" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#FF4F8B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1">
          <mxGeometry x="10" y="40" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s4b_text" parent="s4b" value="Failed / malformed messages&amp;lt;br/&amp;gt;MaxReceiveCount reached" style="text;html=1;align=left;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=8;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="50" y="40" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mod" parent="vpc" value="AI ENGINE RUNTIME (My Module) – Hosted on Amazon EKS (Private Subnet)" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=32;collapsible=0;fillColor=none;strokeColor=#0B7B70;swimlaneFillColor=#FFFFFF;fontColor=#0B7B70;rounded=1;arcSize=8;fontSize=11;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="20" y="520" width="800" height="450" as="geometry" />
        </mxCell>
        <mxCell id="alb" parent="mod" value="Internal ALB" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=24;collapsible=0;fillColor=none;strokeColor=#0B7B70;swimlaneFillColor=#FFFFFF;fontColor=#0B7B70;rounded=1;arcSize=8;fontSize=10;" vertex="1">
          <mxGeometry x="15" y="45" width="200" height="315" as="geometry" />
        </mxCell>
        <mxCell id="alb_icon" parent="alb" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#248813;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;" vertex="1">
          <mxGeometry x="80" y="30" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="alb_text" parent="alb" value="&amp;lt;b&amp;gt;Private, not public&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;AWS Load Balancer Controller&amp;lt;br/&amp;gt;&amp;lt;br/&amp;gt;• TLS 1.2+ (HTTPS)&amp;lt;br/&amp;gt;• Listener: 443&amp;lt;br/&amp;gt;• Target Group Port: 8080&amp;lt;br/&amp;gt;• Health Check: /healthz:8080&amp;lt;br/&amp;gt;• Interval: 30s" style="text;html=1;align=center;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=8;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="10" y="75" width="180" height="230" as="geometry" />
        </mxCell>
        <mxCell id="depA" parent="mod" value="Deployment A: tf1-api (FastAPI)" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=22;collapsible=0;fillColor=none;strokeColor=#0B7B70;swimlaneFillColor=#FFFFFF;fontColor=#0B7B70;rounded=1;arcSize=8;fontSize=9;" vertex="1">
          <mxGeometry x="230" y="45" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="depa_h1" parent="depA" value="" style="shape=hexagon;fillColor=#E1F5FE;strokeColor=#0288D1;rounded=0;" vertex="1">
          <mxGeometry x="105" y="25" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="depa_h2" parent="depA" value="" style="shape=hexagon;fillColor=#E1F5FE;strokeColor=#0288D1;rounded=0;" vertex="1">
          <mxGeometry x="125" y="25" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="depa_h3" parent="depA" value="" style="shape=hexagon;fillColor=#E1F5FE;strokeColor=#0288D1;rounded=0;" vertex="1">
          <mxGeometry x="145" y="25" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="depA_text" parent="depA" value="• Endpoints: POST /v1/triage, GET /v1/reports...&amp;lt;br/&amp;gt;• Compute-FIRST RCA (from full bundle)&amp;lt;br/&amp;gt;• Report Store (persist + index)&amp;lt;br/&amp;gt;• Readiness/Liveness: /healthz:8080 · Cosign-signed" style="text;html=1;align=left;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=8;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="10" y="42" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="depB" parent="mod" value="Deployment B: tf1-worker (AIOps)" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=22;collapsible=0;fillColor=none;strokeColor=#0B7B70;swimlaneFillColor=#FFFFFF;fontColor=#0B7B70;rounded=1;arcSize=8;fontSize=9;" vertex="1">
          <mxGeometry x="230" y="210" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="depb_h1" parent="depB" value="" style="shape=hexagon;fillColor=#E1F5FE;strokeColor=#0288D1;rounded=0;" vertex="1">
          <mxGeometry x="105" y="25" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="depb_h2" parent="depB" value="" style="shape=hexagon;fillColor=#E1F5FE;strokeColor=#0288D1;rounded=0;" vertex="1">
          <mxGeometry x="125" y="25" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="depb_h3" parent="depB" value="" style="shape=hexagon;fillColor=#E1F5FE;strokeColor=#0288D1;rounded=0;" vertex="1">
          <mxGeometry x="145" y="25" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="depB_text" parent="depB" value="• Consume seed from SQS · Query context (read-only)&amp;lt;br/&amp;gt;• Build bundle · Call tf1-api /v1/triage (internal sync)&amp;lt;br/&amp;gt;• Emit outputs: slack_payload, ticket_payload&amp;lt;br/&amp;gt;• Readiness/Liveness: /healthz:8080 · Cosign-signed" style="text;html=1;align=left;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=8;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="10" y="42" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="irsa" parent="mod" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;fontSize=8;fillColor=#FFFFFF;strokeColor=#0B7B70;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="525" y="45" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="irsa_icon" parent="irsa" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#CC2266;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iam;" vertex="1">
          <mxGeometry x="10" y="15" width="35" height="35" as="geometry" />
        </mxCell>
        <mxCell id="irsa_text" parent="irsa" value="&amp;lt;b&amp;gt;IRSA (IAM Roles for Service Accounts)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;Least-Privilege (Scoped)&amp;lt;br/&amp;gt;• bedrock:InvokeModel&amp;lt;br/&amp;gt;• secretsmanager:GetSecretValue&amp;lt;br/&amp;gt;• s3:PutObject (audit bucket ARN)&amp;lt;br/&amp;gt;• dynamodb:* (scoped to table)" style="text;html=1;align=left;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=8;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="50" y="10" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eso" parent="mod" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;fontSize=8;fillColor=#FFFFFF;strokeColor=#0B7B70;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="525" y="210" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="eso_icon" parent="eso" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#CC2266;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1">
          <mxGeometry x="10" y="15" width="35" height="35" as="geometry" />
        </mxCell>
        <mxCell id="eso_text" parent="eso" value="&amp;lt;b&amp;gt;External Secrets Operator (ESO)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;Pull secrets via Secrets Manager VPC Endpoint&amp;lt;br/&amp;gt;Create K8s Secret (No hardcode, No valueFrom)&amp;lt;br/&amp;gt;Injected: BEDROCK credentials, SERVICE_AUTH_TOKEN, other secrets" style="text;html=1;align=left;verticalAlign=top;spacing=2;whiteSpace=wrap;fontSize=8;fontColor=#232F3E;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="50" y="10" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="secgov" parent="mod" value="Security &amp;amp; Governance (In-Cluster)" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;startSize=22;collapsible=0;fillColor=none;strokeColor=#0B7B70;swimlaneFillColor=#FFFFFF;fontColor=#0B7B70;rounded=1;arcSize=8;fontSize=9;" vertex="1">
          <mxGeometry x="15" y="375" width="770" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sg1" parent="secgov" value="Gatekeeper (OPA)&amp;lt;br/&amp;gt;Block root, resources, deny hostNetwork" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=7;fillColor=#FFFFFF;strokeColor=#0B7B70;" vertex="1">
          <mxGeometry x="10" y="25" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sg2" parent="secgov" value="RBAC&amp;lt;br/&amp;gt;developer / sre / viewer" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=7;fillColor=#FFFFFF;strokeColor=#0B7B70;" vertex="1">
          <mxGeometry x="200" y="25" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sg3" parent="secgov" value="NetworkPolicy&amp;lt;br/&amp;gt;Deny-all default + explicit rules" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=7;fillColor=#FFFFFF;strokeColor=#0B7B70;" vertex="1">
          <mxGeometry x="390" y="25" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sg4" parent="secgov" value="Pod Security (Restricted)&amp;lt;br/&amp;gt;Enforce at namespace" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=7;fillColor=#FFFFFF;strokeColor=#0B7B70;" vertex="1">

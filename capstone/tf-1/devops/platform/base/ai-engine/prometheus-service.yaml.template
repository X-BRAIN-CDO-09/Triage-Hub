apiVersion: v1
kind: Service
metadata:
  name: prometheus-operated
  namespace: monitoring
spec:
  ports:
    - name: http
      port: 9090
      targetPort: 9000
      protocol: TCP
---
apiVersion: v1
kind: Endpoints
metadata:
  name: prometheus-operated
  namespace: monitoring
subsets:
  - addresses:
      - ip: PROMETHEUS_IP_PLACEHOLDER
    ports:
      - name: http
        port: 9000
        protocol: TCP

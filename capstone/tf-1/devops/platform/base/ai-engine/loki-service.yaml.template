# Headless Service (clusterIP: None) — cùng lý do với prometheus-service.yaml.template:
# ClusterIP -> Endpoints ngoài VPC qua kube-proxy iptables bị intermittent đã
# verify sống. Headless để DNS trả thẳng IP EC2, bỏ qua kube-proxy. Port dùng
# thống nhất 9000 (nginx proxy thật + port duy nhất SG cho phép) thay vì giả
# 3100 — nginx tự route theo path /loki/ bất kể client gọi cổng nào.
apiVersion: v1
kind: Service
metadata:
  name: loki
  namespace: monitoring
spec:
  clusterIP: None
  ports:
    - name: http
      port: 9000
      protocol: TCP
---
apiVersion: v1
kind: Endpoints
metadata:
  name: loki
  namespace: monitoring
subsets:
  - addresses:
      - ip: LOKI_IP_PLACEHOLDER
    ports:
      - name: http
        port: 9000
        protocol: TCP

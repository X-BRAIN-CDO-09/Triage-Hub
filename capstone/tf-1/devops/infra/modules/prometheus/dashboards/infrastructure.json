{
  "title": "Infrastructure Dashboard",
  "tags": [
    "infrastructure",
    "triage-hub"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 30,
  "panels": [
    {
      "type": "stat",
      "title": "Total Pod Restarts (1h)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Unhealthy Pods",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=~\"Failed|Unknown|Pending\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Nodes Not Ready",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"unknown\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node CPU Utilization (%)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "instance:node_cpu_utilization:rate5m",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node Memory Utilization (%)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "instance:node_memory_utilization:ratio * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk Usage (%)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "100 - (node_filesystem_avail_bytes{fstype=~\"ext4|xfs\"} / node_filesystem_size_bytes{fstype=~\"ext4|xfs\"} * 100)",
          "legendFormat": "{{instance}} - {{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Traffic (bytes/sec)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total[5m])",
          "legendFormat": "{{instance}} - In",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total[5m])",
          "legendFormat": "{{instance}} - Out",
          "refId": "B"
        }
      ]
    }
  ]
}
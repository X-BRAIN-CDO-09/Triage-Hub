# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variables files (if any are created)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/


# Runtime audit data (not source)
capstone/tf-1/devops/app/ai-engine/audit/
capstone/tf-1/devops/app/ai-engine/audit/*.jsonl

# Node dependencies (lambda tests)
node_modules/

# Python virtualenvs
.venv/
venv/

# ⚠️ Secret backups / dumps — KHÔNG BAO GIỜ commit (chứa token live)
secrets_backup.json
secrets*.json
*secret*.json
*.secrets.json
